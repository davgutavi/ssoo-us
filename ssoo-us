def elegir_imagen(o):
    """Fija o.imagen, o.base_img, o.base_img_url, o.base_img_sumas y o.os_variant
    a partir de --imagen. Con --base, el fichero es ese; su tipo lo da --imagen
    si se indica y, si no, se deduce más tarde del propio fichero."""
    gluster = o.glusterfs or o.cluster

    if o.base_opt:
        o.base_img = os.path.join(o.silo, o.base_opt)
        o.base_img_url = ""
        o.base_img_sumas = ""
        if o.imagen_opt:
            if o.imagen_opt not in ("noble", "debian12", "ubuntu-base"):
                fallar(10, "La imagen '%s' (--imagen) no existe. Con --base, indica de cuál sale\n"
                           "el fichero: noble (Ubuntu 24.04), debian12 o ubuntu-base."
                       % o.imagen_opt)
            o.imagen = o.imagen_opt
            o.os_variant = variante_de_imagen(o.imagen)
        return

    o.imagen = o.imagen_opt or (IMAGEN_DEFECTO_GLUSTER if gluster else IMAGEN_DEFECTO)
    if o.imagen == "noble":
        o.base_img = os.path.join(o.silo, IMAGEN_NOBLE)
        o.base_img_url, o.base_img_sumas = URL_NOBLE, SUMAS_NOBLE
    elif o.imagen == "debian12":
        o.base_img = os.path.join(o.silo, IMAGEN_DEBIAN)
        o.base_img_url, o.base_img_sumas = URL_DEBIAN, SUMAS_DEBIAN
    elif o.imagen == "ubuntu-base":
        if not gluster:
            fallar(10, "--imagen ubuntu-base solo sirve para la imagen base GlusterFS (--glusterfs o\n"
                       "--gluster-cluster). Para una máquina suelta usa noble (Ubuntu 24.04) o debian12.")
        o.base_img = o.ubuntu_base_compartida
        o.base_img_url = o.base_img_sumas = ""
    else:
        fallar(10, "La imagen '%s' (--imagen) no existe. Elige una de estas:\n"
                   "  noble        Ubuntu 24.04 (por defecto)\n"
                   "  debian12     Debian 12\n"
                   "  ubuntu-base  la del boletín 1, solo para la base GlusterFS" % o.imagen)
    o.os_variant = variante_de_imagen(o.imagen)


# --- qemu-img ------------------------------------------------------------------

def qemu_info(ruta, forzar=True, cadena=False):
    """«qemu-img info --output=json» ya leído (un diccionario o, con cadena, una
    lista), o None si falla. forzar: con -U (force-share), para poder leer la
    imagen aunque una máquina en ejecución la tenga abierta."""
    orden = ["qemu-img", "info"] + (["-U"] if forzar else [])
    orden += (["--backing-chain"] if cadena else []) + ["--output=json", ruta]
    codigo, salida, _ = ejecutar(orden)
    if codigo != 0:
        return None
    try:
        return json.loads(salida)
    except ValueError:
        return None


def campo_json(datos, campo):
    """jq -r '.CAMPO // empty': el valor como texto, o "" si falta, es null o false."""
    if not isinstance(datos, dict):
        return ""
    valor = datos.get(campo)
    if valor is None or valor is False:
        return ""
    return str(valor)


def tam_a_bytes(tam):
    """40G, 512M o 1T → bytes."""
    return int(tam[:-1], 10) * {"M": 1024 ** 2, "G": 1024 ** 3, "T": 1024 ** 4}[tam[-1]]


def bytes_a_gib(n):
    """Bytes → GiB, redondeando hacia arriba."""
    return (n + 1073741823) // 1073741824


def tam_virtual(ruta):
    """Tamaño virtual de una imagen en bytes (como texto), o "" si no se puede leer."""
    return campo_json(qemu_info(ruta), "virtual-size")


def formato_de(ruta, forzar=True):
    return campo_json(qemu_info(ruta, forzar), "format")


def leer_respaldo(ruta):
    """Imagen base de un fichero (ruta completa), o "". Las rutas relativas son
    relativas al directorio del propio fichero, como las interpreta qemu."""
    b = campo_json(qemu_info(ruta), "backing-filename")
    if b and not b.startswith("/"):
        b = os.path.dirname(ruta) + "/" + b
    return b


# --- La imagen de partida en el silo -----------------------------------------------

def imagen_protegida(o, ruta):
    """¿Es una de las imágenes cloud que descarga el script? Nunca se borran."""
    return ruta in (o.silo + "/" + IMAGEN_NOBLE, o.silo + "/" + IMAGEN_DEBIAN)


def imagen_compartida(o):
    """Copia de la imagen cloud en el directorio compartido de los profesores, si
    la han dejado allí (evita que cada alumno descargue cientos de MB), o ""."""
    ruta = o.dir_compartido + "/" + os.path.basename(o.base_img)
    return ruta if os.access(ruta, os.R_OK) else ""


def origen_disco_principal(o, imagen):
    """Cómo se hace el disco principal a partir de una imagen, para los mensajes."""
    if os.path.dirname(imagen) == o.silo:
        return "copia COW de %s" % os.path.basename(imagen)
    return "copia completa de %s" % imagen


def discos_extra(o, host, unidades):
    """Rutas de los discos extra de una máquina."""
    return ["%s/%s%s-%s.qcow2" % (o.silo, o.prefijo_fichero, host, u) for u in unidades]


def deducir_imagen_de_base(o):
    """Con --base: comprueba que la cadena de respaldo está completa y, si no se
    ha dicho con --imagen, deduce de qué imagen sale el fichero por el nombre de
    la última de la cadena:
      *debian*                     Debian 12
      noble*, *cloudimg*           Ubuntu 24.04 (imagen cloud)
      *ubuntu-base*, *gluster*     ubuntu-base (la base GlusterFS del boletín es
                                   una copia completa suya)
    Si no se reconoce, se trata como imagen cloud de Ubuntu y se avisa: así
    'administrador' siempre tiene sudo."""
    cadena = qemu_info(o.base_img, cadena=True)
    if cadena is None:
        fallar(39, "No se puede leer la imagen %s ni la cadena de imágenes de la que es copia.\n"
                   "Lo más probable es que falte (o se haya movido) la imagen de la que se hizo "
                   "la copia; compruébalo con:\n"
                   "  qemu-img info --backing-chain %s" % (o.base_img, o.base_img))
    if o.imagen_opt:
        return
    ultima = cadena[-1] if isinstance(cadena, list) and cadena else cadena
    raiz = os.path.basename(campo_json(ultima, "filename") or o.base_img)
    # ${raiz,,} con LC_ALL=C: solo las letras ASCII
    nombre = "".join(c.lower() if "A" <= c <= "Z" else c for c in raiz)
    if "debian" in nombre:
        o.imagen = "debian12"
    elif nombre.startswith("noble") or "cloudimg" in nombre:
        o.imagen = "noble"
    elif "ubuntu-base" in nombre or "gluster" in nombre:
        o.imagen = "ubuntu-base"
    else:
        o.imagen = "noble"
        base = os.path.basename(o.base_img)
        print("AVISO: no sé de qué imagen sale %s (no es copia de ninguna imagen conocida)." % base,
              file=sys.stderr)
        print("       Se trata como imagen cloud de Ubuntu 24.04 ('administrador' con sudo sin "
              "contraseña).", file=sys.stderr)
        print("       Si sale de ubuntu-base o de Debian, indícalo: --imagen ubuntu-base, o "
              "--imagen debian12.", file=sys.stderr)
    o.os_variant = variante_de_imagen(o.imagen)


def comprobar_base_no_objetivo(o):
    """La imagen de partida no puede ser uno de los discos que se van a crear
    (con --limpiar se borraría antes de usarla)."""
    for f in o.obj_ficheros:
        if f == o.base_img:
            if o.base_opt:
                fallar(10, "La imagen indicada con --base (%s) es uno de los discos que se "
                           "crearían.\nElige otra imagen o cambia el nombre de la máquina."
                       % os.path.basename(o.base_img))
            fallar(10, "El disco que se crearía se llama %s, que es la imagen de la que\n"
                       "salen todas las máquinas. Ponle otro nombre a la máquina (p.ej. server1)."
                   % os.path.basename(o.base_img))
        if imagen_protegida(o, f):
            fallar(10, "El disco que se crearía se llama %s, que es una de las imágenes cloud de\n"
                       "las que salen las máquinas. Ponle otro nombre a la máquina (p.ej. "
                       "server1)." % os.path.basename(f))


def comprobar_tam_disco(o):
    """--tam no puede ser menor que la imagen de la que se hace la copia: qemu-img
    lo admite, pero la máquina arrancaría con el sistema de ficheros truncado."""
    if not os.path.isfile(o.base_img):
        return
    vs = tam_virtual(o.base_img)
    if re.fullmatch(r"[0-9]+", vs) is None:
        return
    vs = int(vs)
    if tam_a_bytes(o.tam_disco) < vs:
        # Sin --tam, el disco toma el tamaño de la imagen (ubuntu-base tiene 64G)
        if not o.tam_explicito:
            o.tam_disco = "%dG" % bytes_a_gib(vs)
            return
        fallar(15, "El tamaño --tam %s es menor que el de la imagen %s (%d GiB):\n"
                   "la copia quedaría truncada y la máquina no arrancaría bien. Indica un tamaño "
                   "igual o mayor." % (o.tam_disco, os.path.basename(o.base_img), bytes_a_gib(vs)))


def comprobar_imagen_base(o):
    """La imagen de partida: con --base, que exista y sirva; ubuntu-base, que
    esté; las imágenes cloud, que estén (si no, se descargan) y sean qcow2."""
    if o.base_opt:
        if not os.path.isfile(o.base_img):
            fallar(39, "La imagen indicada con --base no está en el silo: %s\n"
                       "Mira qué imágenes tienes con: ls %s/*.qcow2" % (o.base_img, o.silo))
        formato = formato_de(o.base_img)
        if formato != "qcow2":
            fallar(39, "La imagen indicada con --base no es un qcow2 válido: %s (formato: %s).\n"
                       "Mira qué imágenes tienes con: ls %s/*.qcow2"
                   % (o.base_img, formato or "desconocido", o.silo))
        # Una imagen base no puede ser el disco de ninguna máquina, ni siquiera
        # apagada: en cuanto arrancara, escribiría en ella y las copias que
        # dependen de ella quedarían corruptas
        cargar_dominios_vecinos(o)
        otro = o.disco_usado_por.get(o.base_img)
        if otro:
            fallar(39, "La imagen %s es el disco de la máquina '%s' (aunque esté apagada).\n"
                       "Si la usas como imagen base, al arrancar '%s' las copias se "
                       "corromperían.\n"
                       "Elimina antes esa máquina, o haz una copia completa del disco y usa la "
                       "copia:\n  cp %s %s/mi-base.qcow2" % (o.base_img, otro, otro, o.base_img,
                                                            o.silo))
        # Sin -U, qemu-img se niega si otro proceso (p.ej. una máquina de otro
        # usuario) tiene la imagen abierta para escribir
        if qemu_info(o.base_img, forzar=False) is None:
            _, salida, errores = ejecutar(["qemu-img", "info", o.base_img])
            if "lock" in (salida + errores).lower():
                fallar(39, "La imagen %s la tiene abierta para escribir una máquina en "
                           "ejecución.\nApágala (o elimina su dominio) antes de usarla como "
                           "imagen base: las copias de un disco\nque se está escribiendo "
                           "quedarían corruptas." % o.base_img)
        deducir_imagen_de_base(o)
        return

    # ubuntu-base: la dejan los profesores en el servidor; no se descarga
    if o.imagen == "ubuntu-base":
        if not os.access(o.base_img, os.R_OK) or formato_de(o.base_img) != "qcow2":
            fallar(39, "No encuentro la imagen ubuntu-base del boletín 1 en %s\n"
                       "(o no se puede leer, o no es un qcow2). En los servidores de la "
                       "asignatura está ahí.\n"
                       "Si no la tienes, construye la base a partir de una imagen cloud: "
                       "--imagen noble" % o.base_img)
        return

    if not os.path.isfile(o.base_img):
        if o.dry_run:
            # Se avisa dentro del plan, no aquí, para que salga en orden
            o.base_img_falta = True
            return
        descargar_imagen_base(o)
        recien_descargada = True
    else:
        recien_descargada = False

    # -U (force-share) por si alguna máquina en ejecución tiene abierta la
    # imagen; sin él, qemu-img se niega por el bloqueo de escritura
    formato = formato_de(o.base_img)
    if formato != "qcow2":
        if recien_descargada:
            borrar_si_existe(o.base_img)
            fallar(37, "Lo descargado no es un qcow2 válido (formato: %s); se ha eliminado.\n"
                       "Puede que la red del servidor esté redirigiendo la descarga. Descárgala "
                       "tú:\n  wget %s -O %s" % (formato or "desconocido", o.base_img_url,
                                                o.base_img))
        fallar(37, "La imagen base '%s' no es un qcow2 válido (formato: %s).\n"
                   "Probablemente la descarga falló. Bórrala y vuelve a ejecutar el script, que "
                   "la descargará:\n  rm %s" % (o.base_img, formato or "desconocido", o.base_img))


# --- Descarga de la imagen de partida -------------------------------------------------

def descargar(o, url, fichero, silencioso=False):
    """Descarga URL en FICHERO con wget o, si no hay, con curl. Devuelve el código."""
    if shutil.which("wget"):
        orden = ["wget", "-q"] + ([] if silencioso else ["--show-progress"]) + ["-O", fichero, url]
    elif shutil.which("curl"):
        orden = ["curl"] + (["-fsSL"] if silencioso else ["-fL", "--progress-bar"]) \
            + ["-o", fichero, url]
    else:
        fallar(38, "No hay ni wget ni curl para descargar la imagen base.\n"
                   "Descárgala tú en el silo con el nombre %s." % os.path.basename(o.base_img))
    return ejecutar_visible(orden)


def suma_de(fichero, bits):
    h = hashlib.sha256() if bits == 256 else hashlib.sha512()
    with open(fichero, "rb") as f:
        for trozo in iter(lambda: f.read(1 << 20), b""):
            h.update(trozo)
    return h.hexdigest()


def verificar_suma(o, fichero):
    """Compara lo descargado con la suma que se publica junto a la imagen. Si no
    se puede obtener la suma se avisa y se sigue: la imagen se comprueba
    igualmente con qemu-img."""
    if not o.base_img_sumas:
        return
    sumas = fichero + ".sumas"
    nombre = os.path.basename(o.base_img_url)
    bits = 512 if o.base_img_sumas.endswith("SHA512SUMS") else 256
    if descargar(o, o.base_img_sumas, sumas, silencioso=True) != 0:
        borrar_si_existe(sumas)
        print("AVISO: no se ha podido descargar %s para comprobar la imagen." % o.base_img_sumas,
              file=sys.stderr)
        return
    esperadas = []
    for linea in (leer_bytes(sumas) or b"").decode("utf-8", "replace").split("\n"):
        campos = linea.split()
        if len(campos) >= 2 and (campos[1][1:] if campos[1].startswith("*") else campos[1]) == nombre:
            esperadas.append(campos[0])
    borrar_si_existe(sumas)
    esperada = "\n".join(esperadas)
    if not esperada:
        print("AVISO: no se ha podido comprobar la suma SHA-%d de la imagen." % bits,
              file=sys.stderr)
        return
    if esperada != suma_de(fichero, bits):
        borrar_si_existe(fichero)
        quitar_disco_creado(o, fichero)
        fallar(37, "Lo descargado no coincide con la suma publicada (%s): la descarga está\n"
                   "incompleta o alterada, y se ha eliminado. Vuelve a ejecutar el script para "
                   "repetirla." % o.base_img_sumas)
    print("✔ Suma SHA-%d comprobada." % bits)


def descargar_imagen_base(o):
    """Copia la imagen del directorio compartido o la descarga. Con un nombre
    temporal propio de esta ejecución: dos ejecuciones a la vez no se pisan, y
    una descarga a medias nunca se confunde con la imagen (solo se renombra, de
    golpe, si termina bien)."""
    tmp = "%s.descargando.%d" % (o.base_img, os.getpid())
    tam = "unos 430 MB" if o.imagen == "debian12" else "unos 600 MB"
    borrar_si_existe(tmp)
    o.discos_creados.append(tmp)

    compartida = imagen_compartida(o)
    if compartida:
        print("→ No está %s en el silo. Se copia de %s…" % (os.path.basename(o.base_img),
                                                           compartida))
        codigo = ejecutar_visible(["cp", compartida, tmp])
        if codigo != 0:
            borrar_si_existe(tmp)
            quitar_disco_creado(o, tmp)
            fallar(37, "No se ha podido copiar %s (código %d)." % (compartida, codigo))
    else:
        print("→ No está %s en el silo. Se descarga de:" % os.path.basename(o.base_img))
        print("  %s  (%s; puede tardar un rato)" % (o.base_img_url, tam))
        codigo = descargar(o, o.base_img_url, tmp)
        if codigo != 0:
            borrar_si_existe(tmp)
            quitar_disco_creado(o, tmp)
            fallar(37, "No se ha podido descargar la imagen base (código %d).\n"
                       "Comprueba la conexión, o descárgala tú:\n  wget %s -O %s"
                   % (codigo, o.base_img_url, o.base_img))
        verificar_suma(o, tmp)

    os.replace(tmp, o.base_img)
    quitar_disco_creado(o, tmp)
    print("✔ Imagen base lista: %s" % o.base_img)


# --- Discos ---------------------------------------------------------------------------
#
# Todos los discos los crea el script; los registra en o.discos_creados antes de
# crearlos, para que se eliminen si la ejecución falla a medias.

def borrar_si_existe(ruta):
    """rm -f RUTA."""
    try:
        os.remove(ruta)
    except FileNotFoundError:
        pass


def quitar_disco_creado(o, ruta):
    """Quita un fichero del registro de creados (cuando pasa a ser definitivo)."""
    o.discos_creados = [d for d in o.discos_creados if d != ruta]


def qemu_img_crear(argumentos, cwd=None):
    """qemu-img con la salida a /dev/null y los errores a la vista; si falla,
    la ejecución termina de forma inesperada con su código, como con set -e."""
    codigo = ejecutar_visible(["qemu-img"] + argumentos, cwd=cwd, salida=False)
    if codigo != 0:
        raise FalloInesperado(codigo)


def crear_disco_cow(o, ruta, base, tam):
    """Copia COW de una imagen que está en el mismo directorio del silo. El
    respaldo se referencia con ruta relativa, como hace el manual, para que el
    silo se pueda mover sin romper la cadena."""
    o.discos_creados.append(ruta)
    qemu_img_crear(["create", "-f", "qcow2", "-b", os.path.basename(base), "-F", "qcow2",
                    os.path.basename(ruta), tam], cwd=os.path.dirname(ruta))


def crear_disco_copia(o, ruta, origen, tam):
    """Copia completa de una imagen de fuera del silo (ubuntu-base, que está en
    un directorio compartido): una copia COW dependería de un fichero que no es
    del alumno y que puede cambiar. Si se pide un tamaño mayor, se amplía."""
    o.discos_creados.append(ruta)
    codigo = ejecutar_visible(["cp", origen, ruta])
    if codigo != 0:
        raise FalloInesperado(codigo)
    os.chmod(ruta, os.stat(ruta).st_mode | stat.S_IWUSR)
    vs = tam_virtual(ruta)
    if re.fullmatch(r"[0-9]+", vs) and tam_a_bytes(tam) > int(vs):
        qemu_img_crear(["resize", "-q", ruta, tam])


def crear_disco_principal(o, ruta, imagen, tam):
    """Copia COW de una imagen del silo, o copia completa si la imagen está
    fuera de él (ubuntu-base)."""
    if os.path.dirname(imagen) == o.silo:
        crear_disco_cow(o, ruta, imagen, tam)
    else:
        crear_disco_copia(o, ruta, imagen, tam)


def crear_disco_vacio(o, ruta, tam):
    o.discos_creados.append(ruta)
    qemu_img_crear(["create", "-f", "qcow2", ruta, tam])


# --- provision: ficheros de cloud-init ---------------------------------------------
#
#   generar_cloudinit(o, DOMINIO, HOSTNAME, IP, MODO)
#
#   MODO:
#     normal   máquina corriente
#     gluster  nodo GlusterFS suelto, o base del clúster: instala
#              glusterfs-server y xfsprogs, habilita glusterd y resetea el
#              machine-id para que las copias sean máquinas distintas
#     nodo     nodo del clúster, creado a partir de la base: ya tiene todo
#              instalado; solo se personaliza (IP, /etc/hosts, discos xfs)
#
# Deja las rutas en o.workdir, o.user_data, o.meta_data y o.network_data (""
# si DHCP).
#
# Solo se usan claves vigentes en el cloud-init de Ubuntu 24.04: con una
# obsoleta (p.ej. 'chpasswd: list:' o 'ssh-authorized-keys') termina en
# 'degraded done', que el script trata como error.

DNS_DE_LA_US = ("150.214.186.69", "150.214.130.15")
INTERFAZ_VM = "enp1s0"


def yaml_comillas(texto):
    """Escalar YAML entre comillas simples (dentro, la comilla se duplica): así
    una contraseña con ':', '#' o espacios no rompe el user-data."""
    return "'%s'" % texto.replace("'", "''")


def escribir_privado(ruta, texto):
    """Un fichero que solo puede leer su dueño desde el primer instante (en el
    servidor, multiusuario, estos ficheros llevan contraseñas)."""
    fd = os.open(ruta, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "wb") as f:
        f.write(texto.encode("utf-8", "surrogateescape"))
    os.chmod(ruta, 0o600)


def borrar_ruta(ruta):
    """rm -rf RUTA (un enlace simbólico se borra él, no lo que señala)."""
    if os.path.islink(ruta) or os.path.isfile(ruta):
        os.remove(ruta)
    elif os.path.isdir(ruta):
        shutil.rmtree(ruta)


def preparar_workdir(o, dominio):
    """Directorio de los ficheros. En --dry-run es otro, para no sobrescribir los
    de una máquina que ya exista."""
    if o.dry_run:
        o.workdir = "%s/cloudinit-%s.dry-run" % (o.silo, dominio)
    else:
        o.workdir = "%s/cloudinit-%s" % (o.silo, dominio)
        # Si algo falla después, el rollback lo quita junto a los discos
        o.dirs_creados.append(o.workdir)
    # Solo su propietario debe poder leerlos, ni siquiera un instante: por eso
    # el umask, y no un chmod después
    borrar_ruta(o.workdir)
    antes = os.umask(0o077)
    try:
        os.makedirs(o.workdir, exist_ok=True)
    finally:
        os.umask(antes)
    os.chmod(o.workdir, 0o700)
    o.user_data = o.workdir + "/cip-user.yaml"
    o.meta_data = o.workdir + "/cip-meta.yaml"
    o.network_data = ""


def generar_cloudinit(o, dominio, host, ip, modo):
    preparar_workdir(o, dominio)
    # El instance-id importa: cloud-init vuelve a configurar una máquina cuando
    # ve uno distinto del que tenía. Así se personalizan los nodos del clúster,
    # que parten de un disco ya configurado. Lleva la fecha para que sea nuevo
    # aunque el disco de partida ya hubiera sido una máquina con el mismo nombre.
    escribir_privado(o.meta_data, "instance-id: %s-%s\nlocal-hostname: %s\n"
                     % (dominio, time.strftime("%Y%m%d%H%M%S"), host))
    lineas = ["#cloud-config"] + yaml_usuarios(o) + yaml_paquetes_y_ficheros(o, modo, host) \
        + yaml_runcmd(o, modo)
    escribir_privado(o.user_data, "".join(l + "\n" for l in lineas))
    if ip:
        o.network_data = o.workdir + "/cip-net.yaml"
        escribir_privado(o.network_data, texto_network_config(o, ip))


def yaml_usuarios(o):
    """Usuarios, contraseñas y acceso por SSH."""
    l = ["users:", "  - name: administrador"]
    if o.imagen == "ubuntu-base":
        # En ubuntu-base 'administrador' ya existe, con la contraseña del
        # boletín 1, y sudo se la pide: se deja como está (lock_passwd: false
        # para que cloud-init no la bloquee) y solo se añade la clave
        l.append("    lock_passwd: false")
    else:
        l += ["    groups: [sudo]", "    shell: /bin/bash",
              "    sudo: ['ALL=(ALL) NOPASSWD:ALL']"]
    l.append("    ssh_authorized_keys:")
    # Entre comillas: el comentario de la clave puede llevar ': ' o '#'
    l.append("      - %s" % yaml_comillas(o.pubkey))

    # root tiene contraseña para poder entrar por consola (por SSH no entra:
    # el sshd de Debian y el de Ubuntu traen PermitRootLogin prohibit-password).
    # Hace falta, p.ej., en el modo de emergencia del epígrafe 2.3 del boletín 2.
    # 'administrador' solo la tiene si se pide --ssh-pass; si no, entra
    # únicamente por SSH con su clave, igual que en las máquinas que se crean a
    # mano siguiendo el boletín.
    if o.ssh_pass or not o.no_root:
        l += ["chpasswd:", "  expire: false", "  users:"]
        if o.ssh_pass:
            l += ["    - name: administrador",
                  "      password: %s" % yaml_comillas(o.ssh_pass),
                  "      type: text"]
        if not o.no_root:
            l += ["    - name: root", "      password: %s" % PASS_CONSOLA, "      type: text"]

    # SSH por contraseña solo si el alumno lo pide explícitamente. Se fija
    # también el 'false' para no depender del valor por defecto de la imagen,
    # salvo en ubuntu-base, que lo trae activado y se respeta.
    if o.ssh_pass:
        l.append("ssh_pwauth: true")
    elif o.imagen != "ubuntu-base":
        l.append("ssh_pwauth: false")
    return l


def yaml_paquetes_y_ficheros(o, modo, host):
    """Paquetes y, en los nodos, /etc/hosts y discos xfs."""
    if modo in ("normal", "gluster"):
        l = ["package_update: true", "packages:", "  - qemu-guest-agent"]
        if modo == "gluster":
            l.append("  - glusterfs-server")
            # Necesario para que los nodos del clúster puedan formatear sus
            # discos en xfs en el primer arranque
            l.append("  - xfsprogs")
        return l
    if modo != "nodo":
        return []
    # La base ya tiene todo instalado: no hace falta tocar apt
    l = ["package_update: false",
         # Resolución por nombre entre los nodos (epígrafe 2.4 c). Se fija
         # manage_etc_hosts a false para que cloud-init no regenere /etc/hosts
         # en cada arranque y pise lo escrito aquí.
         "manage_etc_hosts: false", "write_files:", "  - path: /etc/hosts",
         "    content: |", "      127.0.0.1 localhost", "      127.0.1.1 %s" % host]
    l += ["      %s %s" % (ip, nodo) for ip, nodo in zip(o.cluster_ips, CLUSTER_NODOS)]
    l += ["      ::1 localhost ip6-localhost ip6-loopback", "      ff02::1 ip6-allnodes",
          "      ff02::2 ip6-allrouters"]
    # Discos vdb, vdc y vdd formateados en xfs. Deben estar conectados desde el
    # primer arranque: por eso se pasan a virt-install en vez de añadirlos
    # después. El montaje va en runcmd (ver yaml_runcmd) para que las líneas de
    # /etc/fstab sean las mismas que escribe crea-entorno.sh; el módulo
    # 'mounts' de cloud-init las escribiría a su manera.
    l.append("fs_setup:")
    for unidad, _ in zip(o.unidades_cluster, CLUSTER_MONTAJES):
        l += ["  - device: /dev/%s" % unidad, "    filesystem: xfs", "    partition: none",
              "    overwrite: false"]
    return l


def yaml_runcmd(o, modo):
    l = ["runcmd:"]
    if modo == "nodo":
        l.append("  - mkdir -p %s" % " ".join(CLUSTER_MONTAJES))
        for unidad, montaje in zip(o.unidades_cluster, CLUSTER_MONTAJES):
            l.append("  - echo '/dev/%s %s xfs %s 0 0' >> /etc/fstab"
                     % (unidad, montaje, OPCIONES_FSTAB_CLUSTER))
        l.append("  - mount -a")
    if o.imagen == "ubuntu-base" and o.no_root:
        # ubuntu-base trae root con contraseña: --no-root la bloquea
        l.append("  - passwd -l root")
    l.append("  - timedatectl set-timezone Europe/Madrid")
    if modo == "gluster":
        # Solo se habilita glusterd, no se arranca: así no genera su UUID en la
        # base, y cada copia tendrá el suyo cuando arranque
        l.append("  - systemctl enable glusterd")
    l.append("  - systemctl start qemu-guest-agent")
    if modo == "gluster":
        # machine-id vacío: cada copia de este disco generará el suyo
        l.append("  - truncate -s 0 /etc/machine-id")
    return l


def texto_network_config(o, ip):
    """network-config, solo si la IP es fija. La pasarela y el prefijo son los de
    la red real. Con 'routes:' en lugar de la obsoleta 'gateway4:', como el
    capítulo 6 del manual."""
    return ("version: 2\n"
            "ethernets:\n"
            "  %s:\n"
            "    addresses:\n"
            "      - %s/%d\n"
            "    routes:\n"
            "      - to: default\n"
            "        via: %s\n"
            "    nameservers:\n"
            "      addresses:\n"
            "        - %s\n"
            "        - %s\n" % ((INTERFAZ_VM, ip, o.red.prefijo, o.red.pasarela) + DNS_DE_LA_US))


# --- provision: libvirt por virsh ------------------------------------------------
#
# provision habla con libvirt con «virsh», como ci-provision.sh: los tests de
# aceptación lo simulan (tests/aceptacion/mocks/virsh) y cuentan sus llamadas.
# Todas pasan por ejecutar(), con LIBVIRT_DEFAULT_URI=qemu:///system.


def virsh(*argumentos):
    """(código, salida, errores) de «virsh ARGUMENTOS»."""
    return ejecutar(["virsh"] + list(argumentos))


def virsh_ok(*argumentos):
    """¿Ha terminado bien «virsh ARGUMENTOS»?"""
    return virsh(*argumentos)[0] == 0


def virsh_salida(*argumentos):
    """La salida de «virsh ARGUMENTOS», o cadena vacía si falla («|| true»)."""
    codigo, salida, _ = virsh(*argumentos)
    return salida if codigo == 0 else ""


def lineas_no_vacias(texto):
    return [linea for linea in texto.split("\n") if linea]


def dominios_del_servidor():
    """Todos los dominios (virsh list --all --name), en su orden."""
    return lineas_no_vacias(virsh_salida("list", "--all", "--name"))


def fuentes_de_domblklist(salida, admitir_guion=False):
    """Segunda columna de «virsh domblklist» tras las dos líneas de cabecera.
    Sin admitir_guion, solo las rutas absolutas (awk '$2 ~ /^\\//'); con él,
    todo lo que no sea «-» (las unidades sin medio)."""
    fuentes = []
    for linea in salida.split("\n")[2:]:
        campos = linea.split()
        if len(campos) < 2:
            continue
        if admitir_guion and campos[1] != "-":
            fuentes.append(campos[1])
        elif not admitir_guion and campos[1].startswith("/"):
            fuentes.append(campos[1])
    return fuentes


def discos_persistentes(dominio, admitir_guion=False):
    """Fuentes de los discos de la definición persistente de un dominio."""
    return fuentes_de_domblklist(virsh_salida("domblklist", dominio, "--inactive"),
                                 admitir_guion)


def red_existe(nombre):
    return virsh_ok("net-info", nombre)


def red_activa(nombre):
    """awk '/^Active:/ { print $2 }' de «virsh net-info» == yes."""
    for linea in virsh_salida("net-info", nombre).split("\n"):
        if linea.startswith("Active:"):
            campos = linea.split()
            return len(campos) > 1 and campos[1] == "yes"
    return False


def obtener_ip_agente(vm):
    """La primera IPv4 no local que reporta el guest agent, o "" si el agente
    no responde todavía."""
    for linea in virsh("domifaddr", vm, "--source", "agent")[1].split("\n"):
        campos = linea.split()
        if len(campos) >= 4 and campos[2] == "ipv4" and not campos[3].startswith("127."):
            return campos[3].split("/")[0]
    return ""


def on_reboot_vivo(vm):
    """on_reboot de la definición con la que se está ejecutando la máquina."""
    return "\n".join(re.findall(r"<on_reboot>([a-z-]*)</on_reboot>", virsh("dumpxml", vm)[1]))


# Expulsión del medio de cloud-init
#
# virt-install genera una ISO efímera en /var/lib/libvirt/boot/ con la
# configuración de cloud-init y la deja enganchada como CD-ROM. libvirt borra
# ese fichero más adelante, pero la referencia permanece en la definición de la
# máquina. Si se toma una instantánea mientras la referencia sigue ahí, al
# revertirla falla con "Cannot access storage file" (apartado B.6 del manual).
# Expulsando el medio en cuanto la máquina está configurada, las instantáneas
# que tome después el alumno ya no pueden heredar el problema.

def cloudinit_unidad(vm):
    """La unidad que tiene enganchada la ISO de cloud-init, mirando tanto la
    definición activa como la persistente, o "" si no hay ninguna."""
    salida = virsh("domblklist", vm)[1] + virsh("domblklist", vm, "--inactive")[1]
    for linea in salida.split("\n"):
        campos = linea.split()
        if len(campos) >= 2 and campos[1].endswith("cloudinit.iso"):
            return campos[0]
    return ""


def eject_cloudinit_media(vm):
    unidad = cloudinit_unidad(vm)
    if not unidad:
        return
    # Por separado sobre cada definición: según el momento, libvirt ya puede
    # haber limpiado una de las dos por su cuenta, y entonces esa llamada falla
    # ('The disk device doesn't have media') aunque la otra sea necesaria y
    # posible. En una sola llamada con --live --config fallarían las dos.
    virsh("change-media", vm, unidad, "--eject", "--live")
    virsh("change-media", vm, unidad, "--eject", "--config")
    # Lo que decide es el estado final, no el código de los intentos
    if not cloudinit_unidad(vm):
        print("✔ Medio de cloud-init expulsado de %s: ya puedes tomar instantáneas." % vm)
    else:
        print("AVISO: no se ha podido expulsar el medio de cloud-init de %s (unidad %s)."
              % (vm, unidad), file=sys.stderr)
        print("       Apaga la máquina antes de tomar instantáneas.", file=sys.stderr)


# --- provision: conflictos con lo que ya existe, y --limpiar -----------------------
#
# El script siempre crea dominios y discos nuevos. Si alguno de los que va a
# crear ya existe, se detiene y lo dice; con --limpiar los elimina antes, pero
# solo exactamente esos: nunca otro dominio ni otro fichero del silo.
#
# Aquí están también las comprobaciones que comparten --limpiar, --eliminar y
# --eliminar-todo para no borrar nunca lo que no se debe:
#   - un disco que use cualquier máquina del servidor que no se vaya a eliminar;
#   - una imagen de la que dependa (directa o indirectamente) una copia que se
#     conserva;
#   - las imágenes cloud de partida;
#   - un dominio cuyos discos no están en el silo (no lo ha creado el alumno
#     con este script, aunque su nombre lo parezca: p.ej. con --prefijo).


def cargar_dominios_vecinos(o):
    """Dominios «vecinos»: TODOS los del servidor que no son objetivo de esta
    ejecución. Cualquiera de ellos podría estar usando un fichero de este silo.
    Deja en o.disco_usado_por, para cada fichero, el primer vecino que lo usa."""
    o.disco_usado_por = {}
    for d in dominios_del_servidor():
        if d in o.obj_dominios:
            continue
        for f in discos_persistentes(d):
            o.disco_usado_por.setdefault(f, d)


def dominio_en_silo(o, dominio):
    """¿Es el dominio de este silo? Todos sus discos tienen que estar en el silo
    (salvo el CD-ROM de cloud-init que deja virt-install), y al menos uno."""
    n = 0
    for f in discos_persistentes(dominio, admitir_guion=True):
        if f.startswith(o.silo + "/"):
            n += 1
        elif not f.endswith("cloudinit.iso"):
            return False
    return n > 0


def ficheros_del_silo(o, *patrones):
    """Los ficheros del silo que casan con cada patrón, en el orden de bash
    (cada patrón ordenado por separado)."""
    ficheros = []
    for patron in patrones:
        ficheros += sorted(glob.glob(os.path.join(glob.escape(o.silo), patron)))
    return [f for f in ficheros if os.path.isfile(f)]


def cargar_respaldos(o):
    """Imagen base de cada qcow2 (y .img) del silo, leída una sola vez: un
    qemu-img por fichero, y todo lo demás se calcula sobre ese mapa."""
    if o.respaldos is None:
        o.respaldos = {}
        for f in ficheros_del_silo(o, "*.qcow2", "*.img"):
            o.respaldos[f] = leer_respaldo(f)
    return o.respaldos


def copias_directas(o, ruta):
    """Copias del silo cuya imagen base es este fichero."""
    return sorted(c for c, b in cargar_respaldos(o).items() if b == ruta)


def filtrar_borrables(o, ficheros):
    """Decide cuáles de estos ficheros se pueden eliminar. Se conservan:
      - las imágenes cloud de partida;
      - los que use una máquina que no se va a eliminar;
      - aquellos de los que dependa una copia que se conserva, aunque sea a
        través de otra (si una copia se queda, se queda toda su cadena).
    Devuelve (borrables, conservados), con «nombre: motivo» en conservados.
    Antes hay que llamar a cargar_dominios_vecinos.

    El orden de los motivos de «imagen base de» puede no ser el de bash, que
    recorre sus tablas en el orden de su hash; aquí se recorren ordenadas."""
    respaldos = cargar_respaldos(o)
    candidatos, conservados = [], []
    for f in ficheros:
        if imagen_protegida(o, f):
            conservados.append("%s: es una imagen cloud de partida (nunca se borra)"
                               % os.path.basename(f))
        elif f in o.disco_usado_por:
            conservados.append("%s: lo usa la máquina '%s'"
                               % (os.path.basename(f), o.disco_usado_por[f]))
        else:
            candidatos.append(f)
    # Lo que se conserva por depender de ello una copia que se queda. Se repite
    # hasta que no cambia nada, para recorrer cadenas de cualquier longitud.
    cambio = True
    while cambio:
        cambio = False
        for f in sorted(candidatos):
            for c in sorted(respaldos):
                if respaldos[c] == f and c not in candidatos:
                    candidatos.remove(f)
                    conservados.append("%s: es la imagen base de %s, que se conserva"
                                       % (os.path.basename(f), os.path.basename(c)))
                    cambio = True
                    break
    return [f for f in ficheros if f in candidatos], conservados


def comprobar_conflictos(o, solo_detectar=False):
    """¿Choca lo que se va a crear (o.obj_dominios, o.obj_ficheros) con lo que
    ya existe? Sin --limpiar, error 21 con las opciones; con --limpiar, lo
    enumera y (salvo en --dry-run) lo elimina, previa confirmación. Con
    solo_detectar (la pasada previa a la descarga), --limpiar solo avisa."""
    dominios, ficheros = [], []
    for d in o.obj_dominios:
        if virsh_ok("dominfo", d):
            # Un dominio que se llama como los que crea el script pero tiene
            # sus discos fuera del silo es de otra persona (o hecho a mano):
            # ni se elimina ni se aconseja eliminarlo
            if not dominio_en_silo(o, d):
                fallar(21, "Ya existe una máquina llamada '%s', pero sus discos no están en tu "
                           "silo:\nno la ha creado este script para ti (puede ser de otro usuario "
                           "del servidor), así que no se toca.\n"
                           "Elige otro nombre de máquina, u otro --prefijo." % d)
            dominios.append(d)
    ficheros = [f for f in o.obj_ficheros if os.path.exists(f)]
    if not dominios and not ficheros:
        return

    # Un fichero que ya existe puede ser el disco de otra máquina (hecha a mano
    # con otro nombre, o de otro prefijo) o el respaldo de otras copias.
    # Entonces ni se elimina ni se aconseja eliminarlo.
    if ficheros:
        cargar_dominios_vecinos(o)
        _, conservados = filtrar_borrables(o, ficheros)
        if conservados:
            fallar(21, "Algunos de los discos que este script tendría que crear ya existen y no "
                       "se pueden eliminar:\n" + "".join("  %s\n" % x for x in conservados)
                   + "Elige otro nombre de máquina (o de disco, con --disco), u otro --prefijo.")

    # En la pasada previa a la descarga solo se avisa; con --limpiar, la
    # eliminación se hace en la pasada definitiva
    if solo_detectar and o.limpiar:
        return

    if not o.limpiar:
        msg = "Ya existen elementos que este script tendría que crear:"
        msg += "".join("\n  dominio  %s" % d for d in dominios)
        msg += "".join("\n  disco    %s" % f for f in ficheros)
        msg += "\n\nEl script siempre crea máquinas y discos nuevos. Tienes estas opciones:"
        msg += "\n  a) Eliminarlos tú:"
        msg += "".join("\n       virsh destroy %s; virsh undefine %s --snapshots-metadata" % (d, d)
                       for d in dominios)
        if dominios:
            msg += ("\n       (si la máquina ya está apagada, 'virsh destroy' dará un error; "
                    "es normal)")
        msg += "".join("\n       rm %s" % f for f in ficheros)
        msg += ("\n  b) Repetir el comando añadiendo --limpiar, que elimina exactamente eso y "
                "nada más.")
        if o.cluster and not o.base_opt and disco_base_cluster(o) in ficheros:
            msg += "\n  c) Reutilizar la imagen base que ya tienes, sin volver a construirla:"
            msg += "\n       %s %s--gluster-cluster --base %s" % (
                orden_provision(), prefijo_en_orden(o), os.path.basename(disco_base_cluster(o)))
            msg += "\n     (añade --limpiar si además existen los nodos)"
        fallar(21, msg)

    print("--limpiar: se van a eliminar estos elementos (y solo estos):")
    for d in dominios:
        print("  dominio  %s" % d)
    for f in ficheros:
        print("  disco    %s" % f)
    if o.dry_run:
        print("  (--dry-run: no se elimina nada)")
        print()
        return

    if not confirmar(o, "¿Eliminar estos elementos?"):
        print("Cancelado: no se ha eliminado nada.")
        print("No se ha creado nada. Usa otro nombre de máquina (o --prefijo) para no pisar lo "
              "que ya tienes.")
        raise FinProvision(0)

    for d in dominios:
        virsh("destroy", d)
        if not virsh_ok("undefine", d, "--snapshots-metadata"):
            fallar(21, "No se ha podido eliminar el dominio '%s'. Inténtalo a mano:\n"
                       "  virsh destroy %s; virsh undefine %s --snapshots-metadata" % (d, d, d))
        print("  ✔ dominio %s eliminado" % d)
    for f in ficheros:
        borrar_si_existe(f)
        print("  ✔ disco %s eliminado" % f)
    print()


RESPUESTAS_SI = ("s", "S", "si", "sí", "Si", "Sí", "SI", "SÍ")


def confirmar(o, pregunta):
    """Pregunta sí/no por teclado. Con --si se da por contestada que sí. Sin
    terminal y sin --si no se puede preguntar, y eliminar sin confirmación sería
    peligroso (p.ej. desde un ssh sin sesión): se detiene con el error 23."""
    if o.si:
        print("%s [s/N] s   (--si)" % pregunta)
        return True
    if not sys.stdin.isatty():
        fallar(23, "Hace falta confirmar («%s») y no hay terminal para preguntarte.\n"
                   "No se ha eliminado nada. Si de verdad quieres hacerlo sin preguntas (p.ej. "
                   "desde\notro script), repite el comando añadiendo --si." % pregunta)
    # Como «read -r -p»: la pregunta por stderr; sin respuesta (fin de la
    # entrada), un salto de línea por stdout
    sys.stderr.write("%s [s/N] " % pregunta)
    sys.stderr.flush()
    linea = sys.stdin.readline()
    if not linea.endswith("\n"):
        respuesta = ""
        print()
    else:
        respuesta = linea[:-1].strip(" \t")
    return respuesta in RESPUESTAS_SI


def prefijo_en_orden(o):
    """«--prefijo PREFIJO » en las órdenes que se sugieren, si se usó."""
    return "--prefijo %s " % o.prefijo_opt if o.prefijo_opt else ""


# --- provision: espera a que cloud-init termine, apagado y reinicio en frío -----------
#
# Una espera de duración fija no sirve: las medidas en los tres servidores
# mostraron que cloud-init tarda entre 60 y 140 segundos según lo que instale y
# la carga del servidor. En su lugar se consulta al guest agent:
#
#   1. Que el agente responda con la IP de la máquina ya dice que ha arrancado
#      y, en una máquina recién creada, que apt ha terminado (el agente se
#      instala con cloud-init).
#   2. Además, a través del propio agente se ejecuta 'cloud-init status' dentro
#      de la máquina, que dice exactamente si ha terminado. Esto es
#      imprescindible en los nodos del clúster, donde el agente ya está
#      instalado de antes y responde mucho antes de que cloud-init acabe.
#
# Si el agente no permite ejecutar órdenes, se recurre solo al punto 1 con un
# pequeño margen, y se avisa.

ORDEN_CLOUDINIT_STATUS = ('{"execute":"guest-exec","arguments":{"path":"/usr/bin/cloud-init",'
                          '"arg":["status"],"capture-output":true}}')


def ahora():
    """Segundos enteros, como $SECONDS en bash."""
    return int(time.monotonic())


def limpiar_linea():
    if sys.stdout.isatty():
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()


def json_o_nada(texto):
    try:
        return json.loads(texto)
    except ValueError:
        return None


def campo_return(datos, campo):
    """jq -r '.return.CAMPO // empty'."""
    if isinstance(datos, dict) and isinstance(datos.get("return"), dict):
        valor = datos["return"].get(campo)
        if valor is not None and valor is not False:
            return valor
    return None


def cloudinit_status(vm):
    """Ejecuta 'cloud-init status' dentro de la máquina a través del guest agent
    y devuelve su estado (done, running, error...), o None si no se ha podido
    consultar. Desde cloud-init 23.4 (Ubuntu 24.04), 'cloud-init status' escribe
    "done" aunque haya terminado con avisos; lo que lo distingue es el código de
    salida: 0 bien, 1 error, 2 terminado con avisos ("degraded")."""
    _, r, _ = virsh("qemu-agent-command", vm, "--timeout", "5", ORDEN_CLOUDINIT_STATUS)
    pid = campo_return(json_o_nada(r), "pid")
    if pid is None:
        return None
    pid = pid if isinstance(pid, str) else json.dumps(pid)
    for _ in range(10):
        time.sleep(1)
        _, s, _ = virsh("qemu-agent-command", vm, "--timeout", "5",
                        '{"execute":"guest-exec-status","arguments":{"pid":%s}}' % pid)
        datos = json_o_nada(s)
        if campo_return(datos, "exited") is not True:
            continue
        try:
            salida = base64.b64decode(campo_return(datos, "out-data") or "").decode("utf-8", "replace")
        except (ValueError, TypeError):
            salida = ""
        codigo = campo_return(datos, "exitcode")
        estado = ""
        for linea in salida.split("\n"):
            if linea.startswith("status:"):
                estado = linea[len("status:"):].lstrip(" ")
                break
        if estado == "done" and codigo in (2, "2"):
            estado = "degraded done"
        return estado
    return None


def maquina_lista(o, vm):
    """¿Está la máquina lista? Deja la IP en o.ips_detectadas y el estado en
    o.estado_ci."""
    ip = obtener_ip_agente(vm)
    if not ip:
        return False
    o.ip_vista[vm] = ip
    # Si se pidió IP fija, se exige esa IP concreta
    if o.ip_esperada.get(vm) and ip != o.ip_esperada[vm]:
        return False

    estado = cloudinit_status(vm)
    if estado is not None:
        o.fallos_consulta[vm] = 0
        o.asumido_desde.pop(vm, None)
        if estado == "done":
            o.ips_detectadas[vm], o.estado_ci[vm] = ip, "done"
            return True
        if estado in ("error", "degraded done"):
            o.ips_detectadas[vm], o.estado_ci[vm] = ip, "error"
            return True
        return False   # running, not run, disabled...

    # No se ha podido consultar cloud-init. Si pasa varias veces seguidas, se da
    # la máquina por lista en cuanto lleve GRACE_SECS respondiendo.
    o.fallos_consulta[vm] = o.fallos_consulta.get(vm, 0) + 1
    if o.fallos_consulta[vm] >= 3 and not o.exigir_estado_ci:
        if vm not in o.asumido_desde:
            o.asumido_desde[vm] = ahora()
        elif ahora() - o.asumido_desde[vm] >= o.esperas["GRACE_SECS"]:
            o.ips_detectadas[vm], o.estado_ci[vm] = ip, "asumido"
            return True
    return False


def esperar_maquinas(o, vms):
    """Espera hasta que todas las máquinas estén operativas o se agote
    WAIT_TIMEOUT. True si todas terminaron."""
    pendientes = list(vms)
    inicio = ahora()
    print("Esperando a que cloud-init termine de configurar %d máquina(s)." % len(pendientes))
    print("Puede tardar entre uno y tres minutos, según lo que haya que instalar.")
    while True:
        restantes = []
        for vm in pendientes:
            if maquina_lista(o, vm):
                transcurrido = ahora() - inicio
                limpiar_linea()
                estado, ip = o.estado_ci[vm], o.ips_detectadas[vm]
                if estado == "done":
                    print("✔ %s operativa tras %ds. IP: %s" % (vm, transcurrido, ip))
                elif estado == "error":
                    print("⚠ %s ha arrancado (IP %s), pero cloud-init informa de errores tras %ds."
                          % (vm, ip, transcurrido))
                    print("  Entra en la máquina y revisa: sudo cloud-init status --long")
                else:
                    print("✔ %s responde tras %ds. IP: %s" % (vm, transcurrido, ip))
                    print("  (no se ha podido consultar el estado de cloud-init; se da por "
                          "terminado)")
            else:
                restantes.append(vm)
        pendientes = restantes
        if not pendientes:
            return True

        transcurrido = ahora() - inicio
        if transcurrido >= o.esperas["WAIT_TIMEOUT"]:
            limpiar_linea()
            err = sys.stderr
            print("AVISO: no ha(n) terminado en %ds: %s" % (o.esperas["WAIT_TIMEOUT"],
                                                         " ".join(pendientes)), file=err)
            print("       Puede que siga(n) instalando paquetes. Comprueba su estado con:", file=err)
            for vm in pendientes:
                print("         virsh domifaddr %s --source agent" % vm, file=err)
                vista = o.ip_vista.get(vm)
                if vista:
                    esperada = o.ip_esperada.get(vm)
                    if esperada and vista != esperada:
                        print("         (%s responde en %s y no en la IP fija %s: la configuración "
                              "de red no se ha aplicado)" % (vm, vista, esperada), file=err)
                    else:
                        print("         (%s ya responde en %s; cloud-init sigue trabajando)"
                              % (vm, vista), file=err)
            print("       Si no responde, entra por consola: virsh console NOMBRE", file=err)
            return False

        if sys.stdout.isatty():
            sys.stdout.write("\r  … %ds  (esperando: %s)" % (transcurrido, " ".join(pendientes)))
            sys.stdout.flush()
        time.sleep(o.esperas["POLL_SECS"])


def apagar_maquina(o, vm):
    """Apaga una máquina de forma limpia y espera a que esté parada. False si no
    se ha apagado en SHUTDOWN_TIMEOUT."""
    virsh("shutdown", vm)
    return esperar_apagada(o, vm)


def esperar_apagada(o, vm):
    """Espera a que una máquina esté parada (a quien ya se le ha pedido apagarse)."""
    inicio = ahora()
    while True:
        if virsh_salida("domstate", vm).rstrip("\n") == "shut off":
            return True
        if ahora() - inicio >= o.esperas["SHUTDOWN_TIMEOUT"]:
            return False
        time.sleep(2)


# Reinicio en frío al terminar
#
# Con --cloud-init, virt-install arranca la máquina con una definición "de
# instalación" que tiene on_reboot=destroy: cuenta con estar él presente en el
# primer reinicio para volver a arrancarla con la definición definitiva
# (on_reboot=restart). Como se lanza con --noautoconsole, termina enseguida y
# nadie hace ese segundo arranque: el primer 'reboot' dentro de la máquina la
# apagaría. Y una instantánea tomada en caliente guardaría ese on_reboot=destroy,
# así que el problema volvería al revertirla.
#
# Apagándola y arrancándola desde fuera, pasa a ejecutarse con la definición
# persistente, que es la buena. Solo se hace cuando cloud-init ya ha terminado:
# antes lo interrumpiría.

def aviso_on_reboot(vms):
    """Aviso para cuando no se ha podido (o no se debía) reiniciar."""
    err = sys.stderr
    print("AVISO: tras crearlas, estas máquinas se apagan en su primer reinicio: %s"
          % " ".join(vms), file=err)
    print("       Cuando terminen de configurarse, apágalas y arráncalas desde fuera:", file=err)
    print("         virsh shutdown NOMBRE   (y, cuando esté apagada)   virsh start NOMBRE", file=err)
    print("       Hazlo antes de tomar instantáneas.", file=err)


def reiniciar_en_frio(o, vms):
    print("→ Apagando y volviendo a arrancar %d máquina(s), para que usen su configuración "
          "definitiva…" % len(vms))
    for vm in vms:
        virsh("shutdown", vm)
    arrancadas, fallidas = [], []
    for vm in vms:
        if esperar_apagada(o, vm) and virsh_ok("start", vm):
            arrancadas.append(vm)
        else:
            fallidas.append(vm)

    # Que vuelvan a responder (con su IP fija, si la tienen)
    inicio = ahora()
    pendientes = list(arrancadas)
    while pendientes:
        restantes = []
        for vm in pendientes:
            ip = obtener_ip_agente(vm)
            if ip and (not o.ip_esperada.get(vm) or ip == o.ip_esperada[vm]):
                o.ips_detectadas[vm] = ip
            else:
                restantes.append(vm)
        pendientes = restantes
        if not pendientes:
            break
        if ahora() - inicio >= o.esperas["WAIT_TIMEOUT"]:
            print("AVISO: no han vuelto a responder en %ds: %s"
                  % (o.esperas["WAIT_TIMEOUT"], " ".join(pendientes)), file=sys.stderr)
            print("       Comprueba su estado con: virsh list --all", file=sys.stderr)
            break
        time.sleep(o.esperas["POLL_SECS"])

    for vm in arrancadas:
        if on_reboot_vivo(vm) == "restart":
            print("✔ %s reiniciada: ya puedes reiniciarla desde dentro y tomar instantáneas." % vm)
        else:
            fallidas.append(vm)
    if fallidas:
        aviso_on_reboot(fallidas)


# --- provision: una máquina suelta ---------------------------------------------------


def construir_comando(o, nombre, ram, vcpus, discos):
    """La orden de virt-install, como lista para poder ejecutarla y mostrarla
    tal cual. Usa los ficheros cloud-init generados justo antes. Los discos se
    conectan en el orden dado: el primero es vda."""
    orden = ["virt-install", "--quiet", "--name", nombre, "--ram", str(ram),
             "--vcpus", str(vcpus), "--import"]
    for disco in discos:
        orden += ["--disk", "path=%s,format=qcow2,bus=virtio" % disco]
    cloud_init = "user-data=%s,meta-data=%s" % (o.user_data, o.meta_data)
    if o.network_data:
        cloud_init += ",network-config=%s" % o.network_data
    orden += ["--os-variant", o.os_variant, "--network", "network=%s" % o.red.nombre,
              "--cloud-init", cloud_init,
              "--graphics", "none" if o.no_graficos else "spice", "--noautoconsole"]
    o.virt_install_cmd = orden


def texto_comando(o):
    """La orden de virt-install, legible: una opción por línea."""
    orden = o.virt_install_cmd
    lineas, i = ["  virt-install \\"], 1
    while i < len(orden):
        arg = orden[i]
        siguiente = orden[i + 1] if i + 1 < len(orden) else ""
        if arg.startswith("--") and siguiente and not siguiente.startswith("--"):
            linea, i = "    %s %s" % (arg, siguiente), i + 2
        else:
            linea, i = "    %s" % arg, i + 1
        lineas.append(linea + (" \\" if i < len(orden) else ""))
    return lineas


def calcular_objetivos(o):
    """Qué va a crear esta ejecución (dominios y ficheros). Se calcula antes de la
    validación que cuesta tiempo (la descarga de la imagen), para avisar de un
    conflicto cuanto antes."""
    if o.cluster:
        objetivos_cluster(o)
        return
    o.extras = discos_extra(o, o.maquina, UNIDADES_EXTRA) if o.extra_disks else []
    if o.disco_main in o.extras:
        fallar(16, "El nombre de disco '%s' coincide con uno de los discos extra que se "
                   "crearían.\nElige otro nombre para el disco principal."
               % os.path.basename(o.disco_main))
    o.obj_dominios = [o.vm_name]
    o.obj_ficheros = [o.disco_main] + o.extras



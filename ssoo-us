ORDENES_PERMITIDAS = ("qemu-img", "ssh-keygen", "ssh", "ssh-add", "ping",
                      "guestfish", "virt-cat", "virt-ls")

# virsh, solo para preguntar al agente QEMU de una máquina encendida (acceso.py),

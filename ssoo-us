        if maquina and not existe:
            anterior = comprobar_intento_anterior(home, uvus, "%s-%s" % (uvus, maquina))
            if anterior:
                informe.bloque("Último virt-install", anterior)
        informe.bloque("Permisos", comprobar_permisos(directorio))
    return informe, maquina, existe


def _meta_del_silo(directorio):
    """(local-hostname, instance-id) de meta-data, o (None, None)."""
    datos = leer_bytes(os.path.join(directorio, "meta-data"))
    if datos is None or yaml is None:
        return None, None
    try:
        meta = yaml.safe_load(datos.decode("utf-8", "replace").lstrip("\ufeff"))
    except yaml.YAMLError:
        return None, None
    if not isinstance(meta, dict):
        return None, None
    host, iid = meta.get("local-hostname"), meta.get("instance-id")
    return (str(host) if host else None), (str(iid) if iid else None)


def _ip_de_network_config(directorio):
    """La IP fija de network-config: la de enp1s0 o, si no la tiene, la de la
    primera interfaz (con eth0 la máquina no la tendrá, pero es la que se espera)."""
    datos = leer_bytes(os.path.join(directorio, "network-config"))
    if datos is None or yaml is None:
        return None
    try:
        ethernets = yaml.safe_load(datos.decode("utf-8", "replace"))["ethernets"]
        nombres = [INTERFAZ_VM] + [n for n in ethernets if n != INTERFAZ_VM]
        for nombre in nombres:
            if isinstance(ethernets.get(nombre), dict):
                for direccion in _como_lista(ethernets[nombre].get("addresses")):
                    try:
                        return ipaddress.ip_interface(str(direccion)).ip
                    except ValueError:
                        continue
    except Exception:
        pass
    return None


def diagnosticar_acceso(uvus, home, directorio, maquina, conn, ip_forzada=None):
    """Revisión de una máquina ya creada, en cinco bloques: 1, la máquina y su red;
    2, su disco; 3, las claves SSH y el acceso; 4, la orden de virt-install con la
    que se creó, y 5, los archivos de cloud-init del silo."""
    informe = Informe()
    nombre = "%s-%s" % (uvus, maquina)
    CONTEXTO.clear()
    CONTEXTO.update(uvus=uvus, maquina=maquina, directorio=directorio)
    dominio = buscar_dominio(conn, nombre)
    if dominio is None:
        informe.bloque("Máquina", [error(
            "No existe la máquina %s" % nombre,
            arreglo="si todavía no la ha creado, revise antes su trabajo con "
                    "ssoo-us diagnosis --antes.", seccion="instanciar")])
        return informe
    m = Maquina(dominio)
    res_claves, clave = comprobar_claves(home)
    res_red, red = comprobar_red(conn, uvus)

    # La IP: la indicada, la de network-config si es de esta máquina, o la de ARP
    _, iid = _meta_del_silo(directorio)
    ip, origen = ip_forzada, "--ip"
    if ip is None and iid == nombre:
        ip, origen = _ip_de_network_config(directorio), "network-config"
    if ip is None and m.encendida:
        ip, origen = ip_por_arp(dominio), "las tablas ARP del servidor"
    CONTEXTO["ip"] = ip

    # 1. La máquina y su red
    maquina_y_red = comprobar_maquina(m, uvus) + res_red
    acceso, entra = [], False
    if m.encendida:
        if ip is None:
            if iid == nombre:
                motivo = "network-config no tiene una dirección IP válida"
            elif iid:
                motivo = "el meta-data del silo es de otra máquina (%s)" % iid
            else:
                motivo = "no hay meta-data en este directorio"
            maquina_y_red.append(omitida(
                "No se sabe la IP de la máquina: %s. Indíquela con --ip" % motivo))
            acceso.append(omitida("Acceso por SSH: no se sabe la IP de la máquina"))
        else:
            res_con, abierto = comprobar_conectividad(ip)
            maquina_y_red += [ok("IP %s (de %s)" % (ip, origen))] + res_con
            if abierto:
                cifrada, en_agente = estado_de_la_clave(home)
                acceso, entra = comprobar_ssh(ip, home, cifrada, en_agente, maquina)
            else:
                acceso.append(omitida("Acceso por SSH: el puerto 22 no responde "
                                      "(bloque 1)"))
    else:
        estado = "apagada" if m.apagada else NOMBRES_ESTADO.get(m.estado, str(m.estado))
        maquina_y_red.append(omitida("Conectividad: la máquina está %s" % estado))
        acceso.append(omitida("Acceso por SSH: la máquina está %s" % estado))
    informe.bloque("1. Máquina y red", maquina_y_red)

    # 2. Su disco: por fuera siempre; por dentro, solo apagada
    informe.bloque("2. Disco", revisar_disco(conn, m, clave, directorio, iid, red, entra))

    # 3, 4 y 5
    informe.bloque("3. Claves SSH y acceso", res_claves + acceso)
    informe.bloque("4. Orden de virt-install", comprobar_orden(home, uvus, nombre))
    res_archivos, _, _ = diagnosticar_archivos(uvus, directorio, maquina, clave, red)
    informe.bloque("5. Archivos de cloud-init (en el silo)", res_archivos)
    compactar_rehacer(informe.todos())
    return informe


def revisar_disco(conn, maquina, clave, directorio, iid, red, entra=False):
    if not maquina.discos:
        return [error("La máquina no tiene ningún disco", fallo="C1",
                      efecto="no puede arrancar.", arreglo=pasos_rehacer(),
                      seccion="instanciar")]
    disco = maquina.discos[0]
    rs = [ok("Disco de la máquina: %s" % disco)]
    if not os.path.exists(disco):
        return rs + [error("No existe el disco de la máquina", fallo="B3",
                           efecto="la máquina no puede arrancar.",
                           arreglo=pasos_rehacer(), seccion="instanciar")]
    por_fuera, falta_respaldo = comprobar_disco_cow(disco, None,
                                                    existe_maquina=True)
    rs += por_fuera
    if maquina.encendida:
        if entra:
            rs.append(omitida("Por dentro: no hace falta revisarlo, puede entrar en la "
                              "máquina"))
        else:
            rs.append(omitida(
                "Por dentro: para revisarlo, apáguela (virsh shutdown %s), espere a que "
                "virsh domstate %s diga «shut off» y vuelva a ejecutar ssoo-us diagnosis"
                % (maquina.nombre, maquina.nombre)))
        return rs
    if not maquina.apagada:
        rs.append(omitida("Por dentro: la máquina tiene que estar apagada (virsh "
                          "shutdown %s)" % maquina.nombre))
        return rs
    if falta_respaldo:
        return rs
    for d in conn.listAllDomains(0):
        if d.name() != maquina.nombre and d.isActive() and disco in discos_de(d):
            return rs + [error(
                "El disco lo está usando la máquina encendida %s" % d.name(),
                fallo="C2", efecto="las dos máquinas acabarían estropeando el disco.",
                arreglo="cada máquina necesita su propio disco. Apague %s (virsh shutdown "
                        "%s) y no la arranque a la vez que esta." % (d.name(), d.name()),
                seccion="instanciar")]
    previo = comprobar_libguestfs()
    if previo is not None and previo.estado == ERROR:
        return rs + [previo]
    archivos, instancias, problema = leer_disco(disco)
    if problema is not None:
        return rs + [problema]
    actual = leer_bytes(os.path.join(directorio, "user-data"))
    actual = actual.decode("utf-8", "replace") if actual is not None else None
    rs += [ok("Por dentro: disco leído (con la máquina apagada)")] + ([previo] if previo
                                                                     else [])
    return rs + comprobar_disco(archivos, instancias, clave, actual, iid, red)


def diagnosis(argv=None):
    """ssoo-us diagnosis ARGUMENTOS. Devuelve el código de salida (la
    codificación de la salida ya la ha preparado main())."""
    argv = sys.argv[2:] if argv is None else argv
    try:
        opciones = analizar_argumentos(argv)
    except ErrorDeUso as e:
        print("ssoo-us diagnosis: %s" % e, file=sys.stderr)
        print("Consulte la ayuda con: ssoo-us diagnosis -h", file=sys.stderr)
        return 2
    if opciones["ayuda"]:
        print(USO_DIAGNOSIS, end="")
        return 0
    if opciones["version"]:
        print("%s %s" % (PROGRAMA, VERSION))
        return 0
    # El usuario de la cuenta, no el de las variables de entorno. Para las
    # pruebas locales se puede fijar con CI_DIAGNOSIS_USUARIO.
    uvus = (os.environ.get("CI_DIAGNOSIS_USUARIO")
            or pwd.getpwuid(os.getuid()).pw_name)
    home = os.path.expanduser("~")
    directorio = os.getcwd()
    maquina = normalizar_maquina(opciones["maquina"], uvus)
    try:
        conn = abrir_conexion()
    except SinLibvirt as e:
        print("ssoo-us diagnosis: %s." % e, file=sys.stderr)
        print("Sin libvirt no se puede hacer la revisión: avise al profesor.",
              file=sys.stderr)
        return 2
    try:
        if maquina is None:
            maquina = normalizar_maquina(_meta_del_silo(directorio)[0], uvus)
        modo = opciones["modo"]
        if modo is None:
            existe = maquina is not None and buscar_dominio(
                conn, "%s-%s" % (uvus, maquina)) is not None
            modo = "acceso" if existe else "antes"
        if modo == "acceso":
            if maquina is None:
                print("ssoo-us diagnosis: indique qué máquina quiere revisar "
                      "(por ejemplo: ssoo-us diagnosis server1 --acceso).", file=sys.stderr)
                return 2
            informe = diagnosticar_acceso(uvus, home, directorio, maquina, conn,
                                          opciones["ip"])
        else:
            informe, maquina, _ = diagnosticar_antes(uvus, home, directorio, maquina, conn)
    finally:
        try:
            conn.close()
        except Exception:
            pass

    servidor = os.uname().nodename.split(".")[0]
    print("ssoo-us diagnosis %s · %s · usuario: %s · máquina: %s" % (
        VERSION, servidor, uvus, "%s-%s" % (uvus, maquina) if maquina else "sin determinar"))
    if modo == "acceso":
        print("Modo: revisión de la máquina ya creada (--acceso)")
        if opciones["modo"] is None:
            print("(La máquina ya existe. Para revisarla como antes de crearla: --antes)")
    else:
        print("Modo: antes de virt-install (--antes)")
    if "dev" in VERSION:
        print("(Versión en desarrollo.)")
    print()
    for linea in formatear_informe(informe, usar_color(sys.stdout)):
        print(linea)
    return informe.codigo_salida()


# --- acceso: por qué no puede entrar por ssh en su máquina (ssoo-us acceso) ------
#
# Para cualquier máquina suya (creada a mano, con ssoo-us provision o con
# ci-provision), encendida: su estado, su IP, el puerto 22, lo que dice ssh y,
# sin apagarla, qué clave tiene administrador (se lee por su agente QEMU, con
# las órdenes de leer archivos del agente: nada de guest-exec). Solo lee, como
# diagnosis: no cambia nada en la máquina ni en la cuenta.

USO_ACCESO = """\
Uso: ssoo-us acceso MAQUINA [--ip IP]

Dice por qué no puede entrar por ssh en una de sus máquinas virtuales (creada
a mano, con ssoo-us provision o con ci-provision) y cómo arreglarlo: si está
encendida, su IP, el puerto 22, lo que dice ssh y, sin apagarla, qué clave
tiene su usuario administrador.

  MAQUINA     la máquina: control2, server1, 1 o <uvus>-server1.
  --ip IP     la IP de la máquina, si no la encuentra sola.
  -h          muestra esta ayuda.
  --version   muestra la versión.

Solo lee: no cambia nada en la máquina ni en su cuenta, y no muestra nunca
su clave privada. Código de salida: 0 si no hay ningún ERROR, 1 si hay
alguno, 2 si no se ha podido hacer la revisión.
"""

FUENTE_LEASE = 0   # VIR_DOMAIN_INTERFACE_ADDRESSES_SRC_LEASE
CLAVES_EN_LA_MAQUINA = "/home/%s/.ssh/authorized_keys" % USUARIO_VM
# El user-data con el que se creó, tal como lo guardó cloud-init en la máquina
USER_DATA_EN_LA_MAQUINA = "/var/lib/cloud/instance/user-data.txt"
SIN_AGENTE = ("not responding", "not connected", "not configured", "agent is not",
              "Guest agent", "guest agent")


def analizar_argumentos_acceso(argv):
    opciones = {"maquina": None, "ip": None, "ayuda": False, "version": False}
    i = 0
    while i < len(argv):
        a = argv[i]
        if a in ("-h", "--help", "--ayuda"):
            opciones["ayuda"] = True
        elif a == "--version":
            opciones["version"] = True
        elif a == "--ip" or a.startswith("--ip="):
            if a == "--ip":
                i += 1
                if i == len(argv):
                    raise ErrorDeUso("falta la IP después de --ip.")
                valor = argv[i]
            else:
                valor = a[len("--ip="):]
            try:
                opciones["ip"] = ipaddress.ip_address(valor)
            except ValueError:
                raise ErrorDeUso("«%s» no es una dirección IP." % valor)
        elif a.startswith("-"):
            raise ErrorDeUso("opción desconocida: %s." % a)
        elif opciones["maquina"] is None:
            opciones["maquina"] = a
        else:
            raise ErrorDeUso("sobra «%s»: indique una sola máquina." % a)
        i += 1
    return opciones


def buscar_maquina_suya(conn, nombre, uvus):
    """El dominio que el alumno llama así: tal cual (con un prefijo propio,
    p.ej. demo-server1) o <uvus>-NOMBRE. None si no existe."""
    for candidato in (nombre, "%s-%s" % (uvus, normalizar_maquina(nombre, uvus))):
        dominio = buscar_dominio(conn, candidato)
        if dominio is not None:
            return dominio
    return None


# --- El agente QEMU ---------------------------------------------------------------

def preguntar_al_agente(dominio, orden, espera=5):
    """(respuesta, problema) de una orden al agente QEMU de la máquina."""
    argv = ["virsh", "-c", URI, "qemu-agent-command", dominio, "--timeout", str(espera),
            json.dumps(orden)]
    codigo, salida, err = ejecutar_lectura(argv, timeout=espera + 15)
    if codigo is None:
        return None, "virsh no ha terminado a tiempo"
    if codigo != 0:
        lineas = [l.strip() for l in err.splitlines() if l.strip()]
        return None, lineas[-1] if lineas else "virsh ha fallado (código %d)" % codigo
    try:
        return json.loads(salida).get("return"), None
    except (ValueError, AttributeError):
        return None, "el agente ha devuelto algo que no se entiende"


def sin_agente(problema):
    return any(s in (problema or "") for s in SIN_AGENTE)


def leer_por_agente(dominio, ruta):
    """(texto, problema) de un archivo de la máquina encendida, leído por su
    agente. problema es «no existe», «sin agente» u otro texto."""
    handle, problema = preguntar_al_agente(
        dominio, {"execute": "guest-file-open", "arguments": {"path": ruta, "mode": "r"}})
    if handle is None:
        if problema and "No such file" in problema:
            return None, "no existe"
        return None, "sin agente" if sin_agente(problema) else problema
    datos = b""
    try:
        while len(datos) < 4 * 1024 * 1024:     # authorized_keys es pequeño
            r, problema = preguntar_al_agente(
                dominio, {"execute": "guest-file-read",
                          "arguments": {"handle": handle, "count": 65536}})
            if r is None:
                return None, problema
            datos += base64.b64decode(r.get("buf-b64") or "")
            if r.get("eof") or not r.get("count"):
                break
    finally:
        preguntar_al_agente(dominio, {"execute": "guest-file-close",
                                      "arguments": {"handle": handle}})
    return datos.decode("utf-8", "replace"), None


def ip_por_agente(dominio):
    r, _ = preguntar_al_agente(dominio, {"execute": "guest-network-get-interfaces"})
    for interfaz in r or []:
        if interfaz.get("name") == "lo":
            continue
        for d in interfaz.get("ip-addresses") or []:
            if d.get("ip-address-type") == "ipv4":
                try:
                    return ipaddress.ip_address(d.get("ip-address"))
                except ValueError:
                    continue
    return None


def ip_por_lease(dominio):
    """IPv4 que el DHCP de su red le ha dado, o None."""
    try:
        datos = dominio.interfaceAddresses(FUENTE_LEASE, 0)
    except Exception:
        return None
    for interfaz in (datos or {}).values():
        for direccion in interfaz.get("addrs") or []:
            if direccion.get("type") == 0:
                try:
                    return ipaddress.ip_address(direccion.get("addr"))
                except ValueError:
                    continue
    return None


# --- Claves ----------------------------------------------------------------------

def claves_del_usuario(home):
    """[(archivo, ClavePublica)] de sus ~/.ssh/*.pub, con id_rsa.pub la primera."""
    directorio = os.path.join(home, ".ssh")
    try:
        nombres = sorted(n for n in os.listdir(directorio) if n.endswith(".pub"))
    except OSError:
        return []
    if "id_rsa.pub" in nombres:
        nombres.remove("id_rsa.pub")
        nombres.insert(0, "id_rsa.pub")
    claves = []
    for n in nombres:
        datos = leer_bytes(os.path.join(directorio, n))
        clave = analizar_clave_publica(datos.decode("utf-8", "replace")) if datos else None
        if clave is not None:
            claves.append((n, clave))
    return claves


def claves_del_texto(texto):
    """Las claves públicas de un authorized_keys (las líneas que lo son)."""
    claves = []
    for linea in texto.splitlines():
        linea = linea.strip()
        if not linea or linea.startswith("#"):
            continue
        clave = analizar_clave_publica(linea)
        if clave is None:
            # Con opciones delante (from=..., command=...): la clave va después
            partes = linea.split()
            for i in range(1, len(partes) - 1):
                clave = analizar_clave_publica(" ".join(partes[i:]))
                if clave is not None:
                    break
        if clave is not None:
            claves.append(clave)
    return claves


def linea_de_la_clave(clave):
    """«tipo blob», sin el comentario (así no hay comillas que escapar)."""
    return "%s %s" % (clave.tipo, base64.b64encode(clave.blob).decode())


def root_en_la_consola(dominio):
    """¿Puede entrar como root en la consola? Lo dice el user-data con que se
    creó la máquina: las de ssoo-us provision y ci-provision dan a root la
    contraseña PASS_CONSOLA (salvo con --no-root); las hechas a mano siguiendo
    el manual no le dan ninguna. Devuelve "conocida" (es PASS_CONSOLA),
    "otra", "no" o None (no se sabe). La contraseña no se muestra nunca."""
    texto, _ = leer_por_agente(dominio, USER_DATA_EN_LA_MAQUINA)
    if texto is None or yaml is None:
        return None
    try:
        datos = yaml.safe_load(texto)
    except yaml.YAMLError:
        return None
    if not isinstance(datos, dict):
        return None
    chpasswd = datos.get("chpasswd")
    if not isinstance(chpasswd, dict):
        return "no"
    claves = []
    for u in chpasswd.get("users") or []:
        if isinstance(u, dict) and u.get("name") == "root" and u.get("password"):
            claves.append(str(u["password"]))
    lista = chpasswd.get("list") or []          # la forma antigua: «root:contraseña»
    for linea in lista.splitlines() if isinstance(lista, str) else lista:
        usuario, _, clave = str(linea).strip().partition(":")
        if usuario == "root" and clave:
            claves.append(clave)
    if not claves:
        return "no"
    return "conocida" if claves[-1] == PASS_CONSOLA else "otra"


def pasos_anadir_clave(dominio, clave, ip, root):
    """(pasos, sección del manual) para añadir su clave a la máquina. Desde la
    consola solo si root tiene contraseña; si no (las hechas a mano), lo que
    dice el manual: apagarla e inyectarla con virt-customize."""
    a_mano = ["Siga el procedimiento del manual: apague la máquina y añádale su clave "
              "actual con virt-customize."]
    if root == "no":
        return a_mano, "faq-publickey"
    contrasena = ("la contraseña es %s" % PASS_CONSOLA if root == "conocida" else
                  "con la contraseña que le dio en user-data" if root == "otra" else
                  "si la creó con ssoo-us provision o con ci-provision, la contraseña es %s"
                  % PASS_CONSOLA)
    pasos = ["Añada su clave a la máquina desde su consola:",
             "1. Entre en la consola, pulse Intro e inicie sesión como root (%s):" % contrasena,
             "$ virsh console %s" % dominio,
             "2. Dentro de la máquina, añada su clave (es una sola línea):",
             "$ echo '%s' >> %s" % (linea_de_la_clave(clave), CLAVES_EN_LA_MAQUINA),
             "3. Salga con exit y luego Ctrl+], y vuelva a entrar:",
             "$ ssh %s@%s" % (USUARIO_VM, ip or "IP")]
    if root is None:
        pasos += ["Si la hizo a mano, root no tiene contraseña: " + a_mano[0][0].lower()
                  + a_mano[0][1:]]
        return pasos, "faq-publickey"
    return pasos, None


def comprobar_clave_de_la_maquina(dominio, home, ip, rechazada):
    """La clave que tiene administrador en la máquina, comparada con las suyas."""
    texto, problema = leer_por_agente(dominio, CLAVES_EN_LA_MAQUINA)
    suyas = claves_del_usuario(home)
    actual = suyas[0][1] if suyas and suyas[0][0] == "id_rsa.pub" else None
    root = root_en_la_consola(dominio) if problema != "sin agente" else None
    sin_clave = ("cree su pareja de claves con ssh-keygen; después tendrá que añadir la "
                 "pública a la máquina como explica el manual.")
    if texto is None:
        if problema == "no existe":
            pasos, seccion = (pasos_anadir_clave(dominio, actual, ip, root) if actual
                              else (sin_clave, "faq-publickey"))
            rs = [error("En la máquina, %s no tiene authorized_keys" % USUARIO_VM,
                        efecto="no se puede entrar por ssh con ninguna clave.",
                        arreglo=pasos, seccion=seccion)]
            return rs
        if problema == "sin agente":
            return [omitida("La clave de la máquina: no se puede ver sin apagarla, porque no "
                            "responde su agente QEMU (las máquinas creadas a mano no suelen "
                            "tenerlo). Con la máquina apagada, ssoo-us diagnosis %s --acceso "
                            "la lee en su disco" % dominio)]
        return [omitida("La clave de la máquina: no se ha podido leer (%s)" % problema)]

    en_la_maquina = claves_del_texto(texto)
    huellas = {c.huella for c in en_la_maquina}
    if actual is not None and actual.huella in huellas:
        rs = [ok("La máquina tiene su clave de ~/.ssh/id_rsa.pub")]
        if rechazada:
            efecto = ("puede que los permisos de /home/%s/.ssh en la máquina no sean los "
                      "que exige ssh." % USUARIO_VM)
            if root in ("conocida", "otra"):
                rs.append(aviso("La máquina tiene su clave, pero ssh la rechaza", efecto=efecto,
                                arreglo=["Desde su consola, como root:",
                                         "$ virsh console %s" % dominio,
                                         "$ chown -R %s: /home/%s/.ssh && chmod 700 "
                                         "/home/%s/.ssh && chmod 600 %s"
                                         % (USUARIO_VM, USUARIO_VM, USUARIO_VM,
                                            CLAVES_EN_LA_MAQUINA)]))
            else:
                rs.append(aviso("La máquina tiene su clave, pero ssh la rechaza", efecto=efecto,
                                arreglo="vuelva a añadirle su clave con el procedimiento del "
                                        "manual (apagarla y usar virt-customize), que deja "
                                        "bien los permisos.",
                                seccion="faq-publickey"))
        return rs
    otras = [(n, c) for n, c in suyas if c.huella in huellas and n != "id_rsa.pub"]
    detalle = ["En la máquina: %s" % c.describir() for c in en_la_maquina] or \
              ["En la máquina: ninguna clave"]
    detalle += ["Suya: %s (~/.ssh/%s)" % (c.huella, n) for n, c in suyas] or \
               ["Suya: ninguna (~/.ssh no tiene claves públicas)"]
    if otras:
        nombre = otras[0][0]
        privada = os.path.join(home, ".ssh", nombre[:-len(".pub")])
        pasos = []
        if os.path.exists(privada):
            pasos = ["Entre con esa clave:",
                     "$ ssh -i ~/.ssh/%s %s@%s" % (nombre[:-len(".pub")], USUARIO_VM, ip or "IP")]
        seccion = None
        if actual is not None:
            anadir, seccion = pasos_anadir_clave(dominio, actual, ip, root)
            pasos += ["O, para entrar con la actual: " + anadir[0][0].lower() + anadir[0][1:]] \
                + anadir[1:]
        return [error("La máquina tiene otra clave suya (~/.ssh/%s), no la de ~/.ssh/id_rsa.pub"
                      % nombre, fallo="B5", detalle=detalle,
                      efecto="ssh entra con ~/.ssh/id_rsa: la máquina se creó con otra clave y "
                             "después cambió la de id_rsa.",
                      arreglo=pasos or None, seccion=seccion)]
    if actual is None:
        return [error("No tiene la clave ~/.ssh/id_rsa.pub", fallo="B5", detalle=detalle,
                      arreglo=sin_clave, seccion="faq-publickey")]
    pasos, seccion = pasos_anadir_clave(dominio, actual, ip, root)
    return [error("La máquina no tiene ninguna de sus claves", fallo="B5", detalle=detalle,
                  efecto="ssh contesta «Permission denied (publickey)». Lo más probable: "
                         "cambió su clave (ssh-keygen) después de crear la máquina.",
                  arreglo=pasos, seccion=seccion)]



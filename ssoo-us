#!/usr/bin/python3
"""ssoo-us: herramientas de la asignatura Sistemas Operativos para crear y
diagnosticar máquinas virtuales con cloud-init en los servidores de la
asignatura.

Asignatura Sistemas Operativos, Universidad de Sevilla.
https://github.com/davgutavi/ssoo-us

Este archivo se genera con tools/build.py a partir de src/: no lo edite a mano.
"""

import os
import subprocess
import sys

VERSION = "0.1.0-dev"
PROGRAMA = "ssoo-us"

# Código de salida de lo que todavía no está portado. No lo usa ci-provision
# (10..45, 70 y 71) ni ci-diagnosis (0, 1 y 2): un test de aceptación que
# espere un código concreto falla siempre con este.
NO_IMPLEMENTADO = 69


# --- Órdenes externas -------------------------------------------------------

def entorno_ordenes(extra=None):
    """Entorno de las órdenes externas.

    LC_ALL=C: salidas en inglés y formato neutro (warcry y megadeth responden en
    español). LIBVIRT_DEFAULT_URI=qemu:///system: sin una sesión de login, o con
    la variable heredada (el libvirt de Homebrew pone qemu:///session), virsh se
    conectaría a otro libvirt y no vería ninguna máquina. Como en ci-provision,
    solo para desarrollo se puede cambiar con CI_PROVISION_LIBVIRT_URI.
    """
    entorno = dict(os.environ, LC_ALL="C", LANG="C")
    entorno["LIBVIRT_DEFAULT_URI"] = (os.environ.get("CI_PROVISION_LIBVIRT_URI")
                                      or "qemu:///system")
    if extra:
        entorno.update(extra)
    return entorno


def ejecutar(argv, timeout=None, entrada=None, entorno=None):
    """Ejecuta una orden externa sin teclado y con entorno_ordenes().

    entrada: texto que recibe por la entrada estándar; sin ella, /dev/null (una
    orden que pregunte no puede quedarse esperando). entorno: variables que se
    añaden a las de entorno_ordenes().

    Devuelve (código, salida, errores). El código es None si la orden no existe
    o no termina a tiempo.
    """
    extra = ({"input": entrada.encode("utf-8")} if entrada is not None
             else {"stdin": subprocess.DEVNULL})
    try:
        p = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                           env=entorno_ordenes(entorno), timeout=timeout, **extra)
    except (OSError, subprocess.TimeoutExpired):
        return None, "", ""
    return (p.returncode, p.stdout.decode("utf-8", "replace"),
            p.stderr.decode("utf-8", "replace"))


# --- Programa principal --------------------------------------------------------

USO = """\
Uso: ./ssoo-us SUBCOMANDO [opciones]

Herramientas de la asignatura Sistemas Operativos (Universidad de Sevilla)
para las máquinas virtuales de los servidores de la asignatura.

Subcomandos:
  provision   crea máquinas virtuales con cloud-init (sustituye a
              ci-provision.sh). Su ayuda: ./ssoo-us provision -h
  diagnosis   revisa la construcción de una máquina y dice qué falla
              (sustituye a ci-diagnosis). Su ayuda: ./ssoo-us diagnosis -h

Opciones:
  --version   muestra la versión.
  -h, --help  muestra esta ayuda.

Código de salida: el del subcomando; 2 si la orden está mal escrita.
"""

SUBCOMANDOS = ("provision", "diagnosis")


def nombre_programa():
    """Cómo se ha llamado al programa, para los mensajes (./ssoo-us, ssoo-us...)."""
    return sys.argv[0] if sys.argv and sys.argv[0] else PROGRAMA


def no_implementado(subcomando):
    print("%s %s: todavía no está implementado (versión %s, en desarrollo)."
          % (PROGRAMA, subcomando, VERSION), file=sys.stderr)
    return NO_IMPLEMENTADO


def provision(argv):
    return no_implementado("provision")


def diagnosis(argv):
    return no_implementado("diagnosis")


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    for flujo in (sys.stdout, sys.stderr):
        try:
            flujo.reconfigure(encoding="utf-8", errors="replace")
        except (AttributeError, ValueError):
            pass
    if not argv:
        print(USO, end="", file=sys.stderr)
        return 2
    primero, resto = argv[0], argv[1:]
    if primero in ("-h", "--help", "--ayuda"):
        print(USO, end="")
        return 0
    if primero == "--version":
        print("%s %s" % (PROGRAMA, VERSION))
        return 0
    if primero == "provision":
        return provision(resto)
    if primero == "diagnosis":
        return diagnosis(resto)
    if primero.startswith("-"):
        problema = "opción desconocida: %s" % primero
    else:
        problema = "subcomando desconocido: %s" % primero
    print("%s: %s (los subcomandos son: %s)." % (PROGRAMA, problema, ", ".join(SUBCOMANDOS)),
          file=sys.stderr)
    print("Consulte la ayuda con: %s -h" % nombre_programa(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/python3
"""ssoo-us-admin: «ssoo-us diagnosis» sobre la cuenta de un alumno, para el profesor.

Uso:
  ssoo-us-admin UVUS [serverX] [--antes | --acceso] [--ip IP] [--dir DIRECTORIO]
  ssoo-us-admin -h

Busca en libvirt los silos y las máquinas del alumno, elige el directorio en el
que trabaja (su silo <uvus>-imagenesMV, o ~/imagenesMV) y lanza «ssoo-us
diagnosis» COMO EL ALUMNO, con sudo: así revisa sus archivos, sus claves y su
acceso por ssh exactamente como los vería él. sudo pide la contraseña del
profesor.

  serverX         la máquina que se revisa (server1, 1 o <uvus>-server1). Si no
                  se indica, diagnosis la toma del meta-data del alumno.
  --antes, --acceso, --ip IP
                  se pasan tal cual a diagnosis.
  --dir DIRECTORIO
                  revisar desde ese directorio en lugar del que se elige solo.

Usa el ssoo-us instalado en el servidor (el del PATH; SSOO_US=RUTA usa otro,
que el alumno tiene que poder leer). diagnosis solo lee: no cambia nada en la
cuenta del alumno. Este script tampoco cambia nada: libvirt se abre en solo
lectura.
"""

import os
import pwd
import re
import shutil
import subprocess
import sys
import xml.etree.ElementTree as ET

URI = "qemu:///system"
INSTALADO = "/usr/local/bin/ssoo-us"
# Lo que hace el alumno, con sudo: entrar en el directorio y ejecutar el
# programa ($0) con el subcomando diagnosis y el resto de argumentos
LANZADOR = 'cd -- "$1" || exit 2; shift; exec /usr/bin/python3 "$0" diagnosis "$@"'


class ErrorDeUso(Exception):
    pass


def analizar_argumentos(argv):
    """Devuelve (uvus, directorio o None, argumentos para diagnosis) o
    ("ayuda",)."""
    if not argv or argv[0] in ("--ayuda", "-h", "--help"):
        return ("ayuda",)
    uvus, resto = argv[0], argv[1:]
    if uvus.startswith("-"):
        raise ErrorDeUso("el primer argumento tiene que ser el UVUS del alumno")
    if not re.match(r"^[a-z][a-z0-9_-]*$", uvus):
        raise ErrorDeUso("«%s» no parece un nombre de usuario" % uvus)
    directorio, pasar = None, []
    i = 0
    while i < len(resto):
        if resto[i] == "--dir":
            if i + 1 == len(resto):
                raise ErrorDeUso("falta el directorio tras --dir")
            directorio = resto[i + 1]
            i += 2
        else:
            pasar.append(resto[i])
            i += 1
    return uvus, directorio, pasar


def _ruta_del_silo(silo):
    try:
        ruta = ET.fromstring(silo.XMLDesc(0)).findtext("target/path")
    except Exception:
        return None
    return os.path.normpath(ruta) if ruta else None


def silos_del_alumno(conn, uvus, home):
    """[(nombre, ruta, activo)] de los silos con su nombre o sobre su home."""
    home = os.path.normpath(home)
    encontrados = []
    for silo in conn.listAllStoragePools(0):
        try:
            nombre = silo.name()
        except Exception:
            continue
        ruta = _ruta_del_silo(silo)
        suyo_por_nombre = nombre.startswith(uvus + "-")
        suyo_por_ruta = ruta is not None and (ruta == home or ruta.startswith(home + "/"))
        if suyo_por_nombre or suyo_por_ruta:
            try:
                activo = bool(silo.isActive())
            except Exception:
                activo = False
            encontrados.append((nombre, ruta, activo))
    return sorted(encontrados)


def maquinas_del_alumno(conn, uvus):
    """[(nombre, encendida)] de las máquinas <uvus>-..."""
    maquinas = []
    for dominio in conn.listAllDomains(0):
        try:
            nombre = dominio.name()
        except Exception:
            continue
        if nombre.startswith(uvus + "-"):
            try:
                encendida = bool(dominio.isActive())
            except Exception:
                encendida = False
            maquinas.append((nombre, encendida))
    return sorted(maquinas)


def elegir_directorio(uvus, home, silos, existe=os.path.isdir):
    """El directorio desde el que se revisa. Por orden: el de su silo
    <uvus>-imagenesMV, ~/imagenesMV, su único silo, su home."""
    for nombre, ruta, _ in silos:
        if nombre == uvus + "-imagenesMV" and ruta and existe(ruta):
            return ruta
    propio = os.path.join(home, "imagenesMV")
    if existe(propio):
        return propio
    con_ruta = [ruta for _, ruta, _ in silos if ruta and existe(ruta)]
    if len(con_ruta) == 1:
        return con_ruta[0]
    return home


def orden_sudo(uvus, directorio, pasar, ssoo_us):
    return (["sudo", "-u", uvus, "-H", "--", "/bin/bash", "-c", LANZADOR,
             ssoo_us, directorio] + list(pasar))


def programa():
    """El ssoo-us que se lanza: SSOO_US, el del PATH o el de /usr/local/bin."""
    return os.environ.get("SSOO_US") or shutil.which("ssoo-us") or INSTALADO


def abrir_libvirt():
    try:
        import libvirt
    except ImportError:
        return None
    libvirt.registerErrorHandler(lambda contexto, error: None, None)
    try:
        return libvirt.openReadOnly(URI)
    except libvirt.libvirtError:
        return None


def main(argv=None):
    argv = sys.argv[1:] if argv is None else argv
    try:
        accion = analizar_argumentos(argv)
    except ErrorDeUso as e:
        print("ssoo-us-admin: %s" % e, file=sys.stderr)
        print("Consulte la ayuda con: ssoo-us-admin -h", file=sys.stderr)
        return 2
    if accion == ("ayuda",):
        print(__doc__.split("\n", 2)[2], end="")
        return 0
    uvus, directorio, pasar = accion
    try:
        home = pwd.getpwnam(uvus).pw_dir
    except KeyError:
        print("ssoo-us-admin: no existe el usuario %s en este servidor." % uvus,
              file=sys.stderr)
        return 2
    ssoo_us = os.path.abspath(programa())
    if not os.path.isfile(ssoo_us):
        print("ssoo-us-admin: no encuentro %s (instálelo con tools/instalar.sh)." % ssoo_us,
              file=sys.stderr)
        return 2

    conn = abrir_libvirt()
    silos, maquinas = [], []
    if conn is not None:
        try:
            silos = silos_del_alumno(conn, uvus, home)
            maquinas = maquinas_del_alumno(conn, uvus)
        finally:
            conn.close()
    else:
        print("(No se pudo consultar libvirt: sin la lista de silos ni de máquinas.)")
    if directorio is None:
        directorio = elegir_directorio(uvus, home, silos)

    print("Alumno: %s (%s)" % (uvus, home))
    print("Silos:     " + ("; ".join("%s → %s%s" % (n, r or "?", "" if a else " (parado)")
                                     for n, r, a in silos) or "ninguno"))
    print("Máquinas:  " + (", ".join("%s (%s)" % (n, "encendida" if e else "apagada")
                                     for n, e in maquinas) or "ninguna"))
    print("Revisión desde %s, como %s (sudo puede pedir su contraseña)." % (directorio, uvus))
    print()
    sys.stdout.flush()
    try:
        return subprocess.run(orden_sudo(uvus, directorio, pasar, ssoo_us)).returncode
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main())
